# Copy to `.env` beside compose.yml and fill in the required values.

# Required. Any long random string; the database is reachable only from this machine.
POSTGRES_PASSWORD=
# Required for the `api` and `full` profiles: the bearer token between the website and the API
# (32+ characters). The public /v1 routes need no token.
EXPLORER_API_TOKEN=
# Optional: a read-only Postgres login, `shieldedscan_reader`, for your own apps.
# POSTGRES_READONLY_PASSWORD=

# A synced Zebra or Zakura node's JSON-RPC URL. Unset: the database stays at the release height.
# A node on this machine: http://host.docker.internal:8232
# NODE_RPC_URL=

# Which release to import: a dataset commit, or a branch (default: the latest, main).
# SELFHOST_REVISION=main
# 1 accepts a release from before miner addresses were published (miners per day are then wrong
# until repair-miner has run against a node).
# SELFHOST_ALLOW_MISSING_COINBASE=0
# Files imported at once. More uses more CPU, memory and database connections.
# SELFHOST_JOBS=2
# Memory per index build after the load.
# SELFHOST_MAINTENANCE_WORK_MEM=1GB
# Postgres shared buffers; about a quarter of the machine's RAM.
# PG_SHARED_BUFFERS=2GB

# On by default: loads the daily ZEC/USD price history (back to 2016) and currency rates, then market
# caps, swap venues, the ZIP index and names, from the internet. 0: after the import, no third party
# is called, and every USD figure stays empty.
# EXTERNAL_SOURCES=1

# Host ports, bound to 127.0.0.1.
# POSTGRES_PORT=5432
# API_PORT=8080
# WEB_PORT=3000

# The website's addresses, built into it (changing one is `docker compose build web`): where you
# open the site, and where its API docs page sends "try it" requests.
# SITE_URL=http://localhost:3000
# API_URL=http://127.0.0.1:8080
