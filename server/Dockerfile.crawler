# The network crawler: outbound P2P handshakes -> parse -> Postgres.
#
# Its own image and container: it opens outbound TCP to arbitrary internet peers, so a
# crash-looping crawler must never cost an ingested block or a served request.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY server ./server
RUN npx esbuild server/crawler-main.ts \
      --bundle --platform=node --target=node22 --format=esm \
      --outfile=dist/crawler.mjs \
      --banner:js="import{createRequire}from'module';const require=createRequire(import.meta.url);"

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/dist/crawler.mjs ./crawler.mjs
# Applied idempotently on boot; the crawler is this schema's only writer.
COPY --from=build /app/server/schema-net.sql ./schema-net.sql

# Never run as root. Needs outbound TCP and Postgres only; holds no API token, node RPC
# access or MaxMind key.
USER node

# No HEALTHCHECK and no exposed port: this process serves nothing. Liveness is its per-cycle
# log line.
CMD ["node", "crawler.mjs"]
