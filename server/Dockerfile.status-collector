# The ecosystem status collector: asks public Zcash services how they are, once a minute, and
# appends the answers to a file per UTC day under /data. It reads no database and no node.

FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY server ./server
COPY scripts/bundle.mjs ./scripts/bundle.mjs
RUN npm run build:status-collector

FROM node:22-alpine AS runtime
WORKDIR /app
# The heap stays well under the container's 128 MB: one answer (Binance's coin list) is ~2 MB of JSON.
ENV NODE_ENV=production STATUS_DATA_DIR=/data NODE_OPTIONS=--max-old-space-size=80
COPY --from=build /app/dist/status-collector.mjs ./status-collector.mjs
USER node

# Healthy while today's file was written in the last three minutes.
HEALTHCHECK --interval=60s --timeout=5s --start-period=120s --retries=3 \
  CMD node -e "const f='/data/status-'+new Date().toISOString().slice(0,10)+'.jsonl';process.exit(Date.now()-require('fs').statSync(f).mtimeMs<180000?0:1)"

CMD ["node", "status-collector.mjs"]
