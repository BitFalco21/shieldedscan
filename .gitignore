# Film renders (brand/trailer/): frames, previews and scores are regenerated by its scripts
brand/trailer/frames*/
brand/trailer/preview/
brand/trailer/score-*.wav
brand/trailer/*.mp4
brand/banner.debug.html
# Brand renders: only the shipped avatar and X header are kept, beside the two source images the
# derivations read. The rest (other sizes, variants, platform mockups, contact sheets) are
# regenerated by the scripts in brand/ whenever they are needed.
/brand/*.png
!/brand/shieldedscan-avatar-400.png
!/brand/shieldedscan-banner-1500x500.png
!/brand/hero-city-clean.png
!/brand/zebra-badge-official.png

# Ecosystem discovery output and HTTP cache (scripts/ecosystem/discover.mjs)
/scripts/ecosystem/out/

# Python bytecode
__pycache__/

# Local tool state and scratch files
.superpowers/
.claude/memory/
.claude/worktrees/
CLAUDE.local.md
meas.mjs
v1.json
