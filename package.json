{
  "name": "shieldedscan",
  "version": "1.0.0",
  "description": "A privacy-first Zcash block explorer: shielded pools, cross-chain flows and network analytics.",
  "homepage": "https://shieldedscan.xyz",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "next build && next start",
    "lint": "eslint --max-warnings 0",
    "check": "tsc --noEmit && npm run lint",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "verify": "npm run format:check && npm run check && npm test && npm run build",
    "check:reference": "node scripts/check-reference-freshness.mjs",
    "tariffs:refresh": "node scripts/fetch-electricity-tariffs.mjs",
    "tariffs:check": "node scripts/fetch-electricity-tariffs.mjs --check",
    "tariffs:validate": "node --env-file-if-exists=.env.local scripts/validate-electricity-tariffs.mjs",
    "map:derive": "python3 brand/world-map-derive.py",
    "build:server": "node scripts/bundle.mjs server/index.ts dist/server.mjs",
    "dev:server": "npm run build:server && node --env-file-if-exists=.env.local dist/server.mjs",
    "build:eval": "node scripts/bundle.mjs server/agent/evals/run.ts dist/eval-agent.mjs",
    "eval:agent": "npm run build:eval && node --env-file-if-exists=.env.local dist/eval-agent.mjs",
    "build:judge": "node scripts/bundle.mjs server/agent/evals/judge-validate.ts dist/eval-judge-validate.mjs && node scripts/bundle.mjs server/agent/evals/judge-review.ts dist/eval-judge-review.mjs",
    "build:fx-validate": "node scripts/bundle.mjs server/fx-validate-main.ts dist/fx-validate.mjs",
    "fx:validate": "npm run build:fx-validate && node --env-file-if-exists=.env.local dist/fx-validate.mjs",
    "build:fill-pool": "node scripts/bundle.mjs server/fill-pool-analytics-main.ts dist/fill-pool-analytics.mjs",
    "fill:pool-analytics": "npm run build:fill-pool && node --env-file-if-exists=.env.local dist/fill-pool-analytics.mjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.12",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "hono": "^4.12.32",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
