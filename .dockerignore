# The build context of every image: only what the Dockerfiles copy, so local state (dependencies,
# build output, history, env files, anything else in the checkout) is never sent at all.
*
!package.json
!package-lock.json
!tsconfig.json
!next.config.ts
!postcss.config.mjs
!public
!scripts
!server
!src
**/node_modules
**/.next
**/.env*
