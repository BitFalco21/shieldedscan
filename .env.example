# Environment variables, by the process that reads them. Copy what you need into `.env.local`
# (git-ignored). Every value here is a placeholder or the default; nothing is required to run the
# frontend on fixtures. Variables named NEXT_PUBLIC_* are inlined into the browser bundle at build
# time, so never put a secret in one.

# =============================================================================================
# Frontend (Next.js)
# =============================================================================================

# Canonical origin for links, the sitemap and share cards. Default: http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# "preview" (not indexable) or "public" (indexable, and refuses to build on fixtures). Default: preview.
NEXT_PUBLIC_STAGE="preview"
# "mainnet" or "testnet"; any other value fails the build. Default: mainnet.
# NEXT_PUBLIC_NETWORK="mainnet"
# Host of the keyless /v1 API, called from the browser by the /api-docs playground.
# NEXT_PUBLIC_API_BASE_URL="https://api.example.org"
# "1" shows the AI assistant (/ai-agent) on mainnet builds. Default: off.
# NEXT_PUBLIC_AGENT_ENABLED="1"

# Base URL of the read-only API service. Unset: every page renders from fixtures.
# CROSSCHAIN_API_URL="https://api.example.org"
# Bearer token the frontend sends to that API. Server-side only; must match the API's own.
# EXPLORER_API_TOKEN=""

# Puts the whole site behind HTTP Basic auth (any username, this password). Unset: no gate.
# SITE_PASSWORD=""
# "1" disables the per-address crawl throttle in src/proxy.ts (for the e2e suite). Default: on.
# CRAWL_GUARD_DISABLED="1"

# Swap-venue explorers that cross-chain transfers link to. Defaults are the venues' own sites.
# NEAR_INTENTS_EXPLORER_URL="https://explorer.near-intents.org"
# MAYA_EXPLORER_URL="https://www.mayascan.org"
# THORCHAIN_EXPLORER_URL="https://thorchain.net"

# =============================================================================================
# API service (server/index.ts)
# =============================================================================================

# Port to listen on. Default: 8080.
# PORT="8080"
# Required. Bearer token for the private routes; use 32 or more random characters.
# EXPLORER_API_TOKEN=""
# Postgres, as a URL or the standard PG* variables (PGHOST, PGPORT, PGUSER, PGPASSWORD,
# PGDATABASE). Unset: an in-memory cross-chain store and no index-backed routes.
# DATABASE_URL="postgres://user:password@localhost:5432/explorer"
# Schema the API applies at start. Default: ./schema.sql (next to the bundle).
# SCHEMA_PATH="./schema.sql"
# JSON-RPC URL of the Zcash node. Unset: the node-backed routes are not mounted.
# NODE_RPC_URL="http://127.0.0.1:8232"
# "mainnet" or "testnet"; any other value refuses to start. Default: mainnet.
# ZCASH_NETWORK="mainnet"
# "primary" runs the background pollers; "replica" serves routes and reads live state from
# PRIMARY_API_URL. Default: primary.
# API_ROLE="primary"
# PRIMARY_API_URL="http://primary-api:8080"

# "1" mounts the public, keyless /v1 API and the MCP server. Default: off.
# PUBLIC_API_ENABLED="1"
# "1" mounts the AI assistant's /agent routes. Default: off.
# AGENT_ENABLED="1"
# Model host for the assistant: "near-ai" or "openrouter". Default: near-ai.
# AGENT_INFERENCE_PROVIDER="near-ai"
# API key for the chosen model host.
# NEAR_AI_API_KEY=""
# OPENROUTER_API_KEY=""
# Tokens the assistant may spend per day before it answers 503. Default: 500000.
# AGENT_DAILY_TOKEN_BUDGET="500000"

# NEAR Intents partner JWT (partners.near-intents.org). Unset: that venue is not polled.
# NEAR_INTENTS_API_KEY=""
# Midgard bases for Maya and THORChain. Defaults are public mirrors; an empty value turns the
# venue off.
# MIDGARD_MAYA_URL="https://midgard.mayachain.info"
# MIDGARD_THORCHAIN_URL="https://gateway.liquify.com/chain/thorchain_midgard"
# DeFiLlama yields endpoint for wrapped-ZEC pools. Default: https://yields.llama.fi.
# DEFILLAMA_YIELDS_URL="https://yields.llama.fi"
# CoinGecko demo key for the price tracker. Optional: the keyless endpoint works.
# COINGECKO_API_KEY=""
# Where the ZIP index is read from. Defaults: GitHub's API and raw hosts.
# ZIPS_GITHUB_API_URL="https://api.github.com"
# ZIPS_RAW_URL="https://raw.githubusercontent.com"
# Zcash Name System registry and the keys it is pinned to. Defaults: the mainnet registry.
# ZNS_URL=""
# ZNS_UIVK=""
# ZNS_ADMIN_PUBKEY=""

# =============================================================================================
# Chain follower and backfill (server/follow-main.ts, server/backfill-main.ts)
# =============================================================================================

# Postgres as above (DATABASE_URL or PG*): required.
# JSON-RPC URL of the Zcash node. Default: http://zakura:8232.
# NODE_RPC_URL="http://127.0.0.1:8232"
# "rollup" stores one row per block; "full" adds transactions and transparent I/O. Default: rollup.
# CHAIN_INGEST_MODE="full"
# Schema applied at start. Default: ./schema-chain.sql.
# CHAIN_SCHEMA_PATH="./schema-chain.sql"
# Blocks per ingest batch. Default: 200.
# FOLLOW_BATCH="200"
# Refresh intervals for the materialised series, in milliseconds.
# MONTHLY_REFRESH_MS="600000"
# DAILY_REFRESH_MS="3600000"
# RICH_LIST_REFRESH_MS="3600000"
# POOL_ANALYTICS_REFRESH_MS="3600000"
# Backfill only: first and last height of a bounded run. Default: genesis to tip - 100.
# BACKFILL_START="0"
# BACKFILL_END=""

# =============================================================================================
# Network crawler (server/crawler-main.ts)
# =============================================================================================

# Postgres as above: required.
# Schema applied at start. Default: ./schema-net.sql.
# NET_SCHEMA_PATH="./schema-net.sql"
# Which network to crawl, and its P2P port. Defaults: mainnet, 8233.
# ZCASH_NETWORK="mainnet"
# ZCASH_P2P_PORT="8233"
# Comma-separated DNS seeds. Default: the mainnet seeds.
# DNS_SEEDS=""
# Concurrent handshakes, and the interval between crawls in milliseconds. Defaults: 48, 600000.
# CRAWL_CONCURRENCY="48"
# CRAWL_INTERVAL_MS="600000"
# "1" also sends addrv2 when asking peers for addresses. Default: off.
# CRAWL_SEND_ADDRV2="1"
# Retention for crawl history, in seconds, and the housekeeping interval in milliseconds.
# PRUNE_NODE_SECONDS="2592000"
# PRUNE_PROBE_SECONDS="2592000"
# HOUSEKEEP_MS="21600000"
# Tor exit list used to label exit nodes. Default: the Tor Project's bulk list.
# TOR_EXIT_LIST_URL="https://check.torproject.org/torbulkexitlist"

# scripts/refresh-geoip.sh: MaxMind licence key, plus the Docker network and image it runs psql in.
# MAXMIND_LICENSE_KEY=""
# GEOIP_DOCKER_NETWORK="zcash"
# GEOIP_PSQL_IMAGE="postgres:17"

# =============================================================================================
# Maintenance jobs (server/repair-*-main.ts); each file's header says which ones it reads
# =============================================================================================

# REPAIR_PHASE=""          step to run: status, stage, apply, verify, fill or check
# REPAIR_COMMIT="1"        commit instead of a dry run (repair-reorg-addresses)
# REPAIR_BATCH=""          rows or blocks per batch
# REPAIR_LIMIT=""          stop after this many rows
# REPAIR_END=""            last height to repair
# REPAIR_CONCURRENCY=""    parallel node calls
# REPAIR_REFRESH="0"       skip refreshing the materialised views afterwards
# REPAIR_SAMPLE=""         rows sampled by a verify phase
# REPAIR_DUTY=""           fraction of time spent working rather than yielding to ingestion
# REPAIR_STALL_BLOCKS=""   ingestion lag, in blocks, that pauses the job
# REPAIR_HEIGHT_CHUNK=""   heights per staged chunk
# REPAIR_CHUNKS=""         chunks to stage in this run
# REPAIR_TARGET_MS=""      target duration of one chunk
# REPAIR_WORK_MEM=""       Postgres work_mem for the heavy statement
# REPAIR_REORG_MARGIN=""   blocks below the tip left for the follower

# =============================================================================================
# Tests, evals and tooling
# =============================================================================================

# Database suites run only with this set; the role needs CREATEDB.
# TEST_DATABASE_URL="postgres://user:password@localhost:5432/explorer_test"
# "1" also runs the suites that need a database holding real chain data.
# TEST_DATABASE_HAS_REAL_DATA="1"
# Node for the live follower test (server/__tests__/follow-live.test.ts).
# TEST_NODE_RPC_URL="http://127.0.0.1:18232"
# Run Playwright against an already-running server instead of building one.
# PLAYWRIGHT_BASE_URL="http://localhost:3000"
# "1" lets the external-link suite resolve venue links for real data.
# E2E_LIVE_DATA="1"
# Agent eval runner: the API it dispatches to, and the public /v1 host it reads.
# EVAL_CHAIN_BASE_URL="http://127.0.0.1:8080"
# EVAL_CHAIN_TOKEN=""
# EVAL_V1_BASE_URL="https://api.example.org"
# Electricity tariff scripts: source hosts and an optional EIA key (default DEMO_KEY).
# GPP_URL="https://www.globalpetrolprices.com"
# EUROSTAT_URL=""
# FRANKFURTER_URL=""
# EIA_URL=""
# EIA_API_KEY=""
# Brand generators (brand/): which mark, the skyline seed, the share-card backdrop, debug output.
# MARK=""
# ALT_MARK=""
# SEED="7"
# OG_BACKDROP="photo"
# DEBUG_HTML="1"
# Film renderer (brand/trailer/): which film page and the frames directory.
# FILM="trailer.html"
# FRAMES_DIR="frames"
# Set by the platform, never by hand: CI (GitHub Actions), URL (Netlify), NODE_PATH.
